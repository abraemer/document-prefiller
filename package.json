{
  "name": "document-prefiller",
  "version": "1.0.1",
  "description": "A desktop application for prefilling Microsoft Word documents with replacement markers",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/abraemer/document-prefiller",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:visuals": "node .opencode/skills/tutorial-visuals/scripts/capture-visuals.mjs"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.0",
    "jszip": "^3.10.1",
    "sass": "^1.97.3",
    "vue": "^3.4.0",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vue/test-utils": "^2.4.6",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.documentprefiller.app",
    "productName": "Document Prefiller",
    "publish": {
      "provider": "github",
      "owner": "abraemer",
      "repo": "document-prefiller"
    },
    "directories": {
      "output": "release",
      "buildResources": "public/icons"
    },
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.png",
      "category": "Office",
      "maintainer": "Document Prefiller Team"
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Document Prefiller"
    },
    "portable": {
      "artifactName": "${name}-portable-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
